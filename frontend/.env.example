# Copy to .env.local (gitignored) and adjust.

# ML API: live predictions, "Recalculate on IBM Z", and building history for address lookups
# (FISP filings, DOB/ECB/311 records, satellite ground movement). Default http://localhost:8000.
# Local: `cd ml && uvicorn urban_sentinel.serve:app --port 8000`. LinuxONE: the SSH tunnel in ml/deploy/linuxone/RUNBOOK.md.
VITE_API_URL=http://localhost:8000

# Optional: a different address-search endpoint (default: NYC Planning Labs GeoSearch v2 autocomplete).
# VITE_GEOSEARCH_URL=https://geosearch.planninglabs.nyc/v2/autocomplete

# Optional: Street View images in the building panel. A Google Maps browser key with only the
# "Street View Static API" enabled, restricted to HTTP referrers (e.g. http://localhost:5173/*).
# Put it in .env.local, never in this file. Without it the panel still shows aerial photos.
# VITE_GOOGLE_MAPS_KEY=
